APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL. Managed production providers normally require TLS.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/herstyleai
DB_SSL_MODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

JWT_SECRET_KEY=change-me-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Development returns a one-time reset token for local testing. Production
# must use email delivery and must not expose the token in API JSON.
PASSWORD_RESET_DELIVERY=token
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Production should use cookie-only refresh tokens over HTTPS.
REFRESH_TOKEN_MODE=cookie
REFRESH_COOKIE_NAME=herstyleai_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
TRUSTED_PROXY_IPS=127.0.0.1
ENABLE_API_DOCS=true

# User-facing runtime writes must point to a persistent volume in production.
STORAGE_BACKEND=local
STORAGE_ROOT=
MAX_UPLOAD_BYTES=10485760

# These are a process-local safety net. Use edge/Redis limits for replicas.
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
REFRESH_RATE_LIMIT=30
AI_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60
